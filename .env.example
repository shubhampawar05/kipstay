# PostgreSQL connection (matches docker-compose.yml)
DATABASE_URL="postgresql://kipstay:kipstay@localhost:5433/kipstay?schema=public"

# Password given to every demo account created by `npm run db:seed`.
# Demo accounts: guest@kipstay.test, host@kipstay.test, host2@kipstay.test
SEED_DEMO_PASSWORD="kipstay-demo-2026"

# Payments: only the clearly labelled mock provider is implemented.
PAYMENT_PROVIDER="mock"
